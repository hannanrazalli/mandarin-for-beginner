{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.json",
      "vite.config.ts",
      "playwright.config.ts",
      "index.html",
      "!pnpm-lock.yaml",
      "!package.json",
      "!tsconfig.json",
      "scripts/**/*.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
